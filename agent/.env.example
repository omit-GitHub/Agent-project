# GUIAgent Agent 配置文件
# 复制本文件为 .env 并填入你的配置

# ─── 必填：DashScope API Key ───
# 在阿里云 DashScope 控制台获取: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=xx

# ─── 设备连接 ───
# Agent 运行在设备上时填 127.0.0.1，在 PC 上填设备 IP
DEVICE_IP=127.0.0.1
DEVICE_PORT=8765

# ─── 模型选择 ───
# 可选: qwen-turbo(快), qwen-plus(均衡), qwen-max(最强), qwen-long(长文本)
MODEL_NAME=qwen-plus

# ─── 高级选项 ───
# 最大连续 function call 次数（防死循环）
MAX_TOOL_CALLS=5
# 对话历史最大轮数
MAX_HISTORY_TURNS=20
# 调试模式（1=开启，显示命令调用详情）
AGENT_DEBUG=0
